# KAG-LangGraph Environment Configuration
# Copy this file to .env and fill in your actual values

# =============================================================================
# LLM API KEYS
# =============================================================================

# OpenAI API Configuration
# Required for LLM-based entity extraction and relationship extraction
OPENAI_API_KEY=your-openai-api-key-here

# Optional: OpenAI API Base URL (for custom endpoints or proxies)
# OPENAI_BASE_URL=https://api.openai.com/v1

# Ollama Configuration (for local LLM inference)
# Default: http://localhost:11434
OLLAMA_BASE_URL=http://localhost:11434

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================

# Neo4j Database Configuration (optional - for graph database storage)
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your-neo4j-password-here
NEO4J_DATABASE=neo4j

# =============================================================================
# PIPELINE CONFIGURATION
# =============================================================================

# Logging Configuration
LOG_LEVEL=INFO

# Output and Temporary Directories
OUTPUT_DIR=./output
TEMP_DIR=./temp

# Pipeline Execution Settings
MAX_WORKERS=4
BATCH_SIZE=100
PIPELINE_TIMEOUT=3600

# =============================================================================
# COMPONENT-SPECIFIC CONFIGURATION
# =============================================================================

# LLM Extractor Settings
LLM_PROVIDER=openai
LLM_MODEL=gpt-3.5-turbo
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=2000

# Text Splitter Settings
CHUNK_SIZE=1000
CHUNK_OVERLAP=100

# Embedding Model Settings
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_BATCH_SIZE=32
EMBEDDING_MAX_LENGTH=512

# =============================================================================
# FILE PROCESSING CONFIGURATION
# =============================================================================

# Default file encoding for text processing
DEFAULT_ENCODING=utf-8

# Supported file types (comma-separated)
SUPPORTED_FILE_TYPES=pdf,txt,docx,md

# Maximum number of files to process (0 = no limit)
MAX_FILES=0

# =============================================================================
# DEVELOPMENT AND TESTING
# =============================================================================

# Development mode (enables additional logging and debugging)
DEBUG=false

# Test data directory
TEST_DATA_DIR=./tests/data

# =============================================================================
# OPTIONAL INTEGRATIONS
# =============================================================================

# Azure OpenAI Configuration (alternative to OpenAI)
# AZURE_OPENAI_API_KEY=your-azure-openai-key
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
# AZURE_OPENAI_API_VERSION=2023-12-01-preview

# Hugging Face Configuration (for alternative embedding models)
# HUGGINGFACE_API_KEY=your-huggingface-token

# =============================================================================
# SECURITY AND PERFORMANCE
# =============================================================================

# API request timeout (seconds)
API_TIMEOUT=30

# Maximum retries for API calls
MAX_RETRIES=3

# Rate limiting (requests per minute)
RATE_LIMIT=60

# =============================================================================
# USAGE NOTES
# =============================================================================

# 1. OPENAI_API_KEY is required for LLM-based extraction
# 2. Neo4j credentials are only needed if using Neo4j writer component
# 3. OLLAMA_BASE_URL is only needed if using Ollama for local LLM inference
# 4. Most settings have sensible defaults and can be left unchanged
# 5. Environment variables can be referenced in config.yaml using ${VAR_NAME} syntax
# 6. For production, consider using a secrets management system instead of .env files

# =============================================================================
# EXAMPLE CONFIGURATION REFERENCES
# =============================================================================

# In your config.yaml, you can reference these environment variables like:
# 
# extractor:
#   type: "llm_extractor"
#   config:
#     api_key: "${OPENAI_API_KEY}"
#     model: "${LLM_MODEL:gpt-3.5-turbo}"  # with default fallback
#     temperature: "${LLM_TEMPERATURE:0.1}"
#
# writer:
#   type: "neo4j_writer"
#   config:
#     uri: "${NEO4J_URI}"
#     username: "${NEO4J_USERNAME}"
#     password: "${NEO4J_PASSWORD}"
