# =============================================================================
# KAG-LangGraph Environment Configuration
# Copy this file to .env and fill in your actual values
# =============================================================================

# ── LLM API Keys ────────────────────────────────────────────────────
OPENAI_API_KEY=your-openai-api-key-here

# Chat-specific LLM settings (used by the RAG chatbot)
# CHAT_OPENAI_BASE_URL=           # Optional: custom endpoint URL
# CHAT_OPENAI_API_KEY=            # Optional: falls back to OPENAI_API_KEY
CHAT_LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.1

# Pipeline LLM settings (used by the extraction pipeline)
LLM_PROVIDER=openai
LLM_MODEL=gpt-3.5-turbo
LLM_MAX_TOKENS=2000

# ── Embedding ───────────────────────────────────────────────────────
EMBEDDING_PROVIDER=gemini          # gemini | ollama | sentence-transformers
EMBEDDING_MODEL=gemini-embedding-001
GOOGLE_API_KEY=your-google-api-key-here

# ── Neo4j Database ──────────────────────────────────────────────────
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your-neo4j-password-here
NEO4J_DATABASE=neo4j

# ── Server ──────────────────────────────────────────────────────────
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
SERVER_RELOAD=false
LOG_LEVEL=INFO
DEBUG=false

# CORS origins (JSON array)
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# ── Authentication ──────────────────────────────────────────────────
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ── MCP Integration ────────────────────────────────────────────────
# MCP_SERVER_URL=https://dev-mcp-server-v3.stock-gpt.ai/sse

# ── Pipeline ────────────────────────────────────────────────────────
PIPELINE_CONFIG_PATH=configs/financebench_pipeline.yaml
OUTPUT_DIR=./output
MAX_WORKERS=4
BATCH_SIZE=100

# ── LangSmith Tracing (optional) ───────────────────────────────────
# LANGSMITH_API_KEY=your-langsmith-key
# LANGSMITH_PROJECT=kag-langgraph-server
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com
