namespace TestInstruction

TaxOfTestType: ConceptType
	hypernymPredicate: isA

TaxOfEquipmentType: ConceptType
	hypernymPredicate: isA

Equipment: EntityType
	properties:
		equipmentId: Text
			index: Text
		desc: Text
			index: Text
		semanticType: Text
			index: Text
		IND#belongTo: TaxOfEquipmentType
	relations:
		usedBy: TestInstruction
			constraint: MultiValue

Others: EntityType
	properties:
		desc: Text
			index: TextAndVector
		semanticType: Text
			index: Text

InstructionStep: EntityType
	properties:
		semanticType: Text
			index: Text
		stepOrder: Integer
		desc: Text
			index: Text
		duration: Integer
	relations:
		dependsOn: InstructionStep
			constraint: MultiValue
		uses: Equipment
			constraint: MultiValue

Condition: EntityType
	properties:
		conditionId: Text
			index: Text
		desc: Text
			index: Text
		semanticType: Text
			index: Text
		priority: Integer
	relations:
		appliesTo: TestInstruction
			constraint: MultiValue

TestInstruction: EntityType
	properties:
		instructionId: Text
			index: Text
		desc: Text
			index: Text
		semanticType: Text
			index: Text
		complexity: Integer
		IND#belongTo: TaxOfTestType
	relations:
		hasCondition: Condition
			constraint: MultiValue
		hasPurpose: Purpose
			constraint: MultiValue
		hasStep: InstructionStep
			constraint: MultiValue
		requiresEquipment: Equipment
			constraint: MultiValue
		followedBy: TestInstruction
			properties:
				sequenceOrder: Integer
		validates: TestInstruction
			rule: [[
				Define (s:TestInstruction)-[p:validates]->(o:TestInstruction) {
					STRUCTURE {
						(s)-[:hasStep]->(step:InstructionStep),
						(step)-[:uses]->(eq:Equipment)<-[:requiresEquipment]-(o)
					}
					CONSTRAINT {
						stepCount = group(s,o).count(step)
						R1("Validation requires multiple steps"): stepCount > 1
					}
				}
			]]

Chunk: EntityType
	properties:
		chunkId: Text
			index: Text
		content: Text
			index: TextAndVector
		sourceFile: Text
			index: Text
	relations:
		relatesTo: TestInstruction
			constraint: MultiValue

TestType: ConceptType
	hypernymPredicate: isA

Purpose: EntityType
	properties:
		purposeId: Text
			index: Text
		semanticType: Text
			index: Text
		desc: Text
			index: Text
		importance: Integer
	relations:
		achievedBy: TestInstruction
			constraint: MultiValue

TestCategory: ConceptType
	hypernymPredicate: isA

Laboratory: EntityType
	properties:
		labId: Text
			index: Text
		name: Text
			index: Text
		certification: Text
	relations:
		hasEquipment: Equipment
			constraint: MultiValue
		conducts: TestInstruction
			constraint: MultiValue

