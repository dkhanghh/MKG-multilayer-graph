namespace Finance

Chunk: EntityType
     properties:
        content: Text
            index: TextAndVector

Industry: ConceptType
     hypernymPredicate: isA

TimePeriod: ConceptType
     hypernymPredicate: isA

FinancialMetricCategory: ConceptType
     hypernymPredicate: isA

ProductCategory: ConceptType
     hypernymPredicate: isA

ExecutiveRole: ConceptType
     hypernymPredicate: isA

RegionType: ConceptType
     hypernymPredicate: isA

EventType: ConceptType
     hypernymPredicate: isA

ReportType: ConceptType
     hypernymPredicate: isA

Company: EntityType
     properties:
        desc: Text
            index: Text
        semanticType: Text
            index: Text
        ticker: Text
            index: Text
        industry: Industry
            constraint: MultiValue
     relations:
        hasSubsidiary: Company
        subsidiaryOf: Company
        competitor: Company
        hasExecutive: Executive
        hasProduct: Product
        hasSegment: BusinessSegment
        operatesIn: GeographicRegion
        issues: FinancialReport
        files: RegulatoryFiling

FinancialMetric: EntityType
     properties:
        desc: Text
            index: Text
        semanticType: Text
            index: Text
        value: Text
            index: Text
        unit: Text
            index: Text
        category: FinancialMetricCategory
     relations:
        relatedTo: Company
        reportedIn: TimePeriod

Revenue: EntityType
     properties:
        desc: Text
            index: Text
        semanticType: Text
            index: Text
        amount: Text
            index: Text
        currency: Text
            index: Text
     relations:
        relatedTo: Company
        reportedIn: TimePeriod

Profit: EntityType
     properties:
        desc: Text
            index: Text
        semanticType: Text
            index: Text
        amount: Text
            index: Text
        profitType: Text
            index: Text
     relations:
        relatedTo: Company
        reportedIn: TimePeriod

Expense: EntityType
     properties:
        desc: Text
            index: Text
        semanticType: Text
            index: Text
        amount: Text
            index: Text
        expenseType: Text
            index: Text
     relations:
        relatedTo: Company
        reportedIn: TimePeriod

Asset: EntityType
     properties:
        desc: Text
            index: Text
        semanticType: Text
            index: Text
        amount: Text
            index: Text
        assetType: Text
            index: Text
     relations:
        relatedTo: Company
        reportedIn: TimePeriod

Liability: EntityType
     properties:
        desc: Text
            index: Text
        semanticType: Text
            index: Text
        amount: Text
            index: Text
        liabilityType: Text
            index: Text
     relations:
        relatedTo: Company
        reportedIn: TimePeriod

Equity: EntityType
     properties:
        desc: Text
            index: Text
        semanticType: Text
            index: Text
        amount: Text
            index: Text
     relations:
        relatedTo: Company
        reportedIn: TimePeriod

FinancialRatio: EntityType
     properties:
        desc: Text
            index: Text
        semanticType: Text
            index: Text
        value: Text
            index: Text
        ratioType: Text
            index: Text
     relations:
        relatedTo: Company
        calculatedFor: TimePeriod

Product: EntityType
     properties:
        desc: Text
            index: Text
        semanticType: Text
            index: Text
        category: ProductCategory
     relations:
        producedBy: Company
        belongsToSegment: BusinessSegment

Executive: EntityType
     properties:
        desc: Text
            index: Text
        semanticType: Text
            index: Text
        position: Text
            index: Text
        role: ExecutiveRole
     relations:
        worksFor: Company
        leadsSegment: BusinessSegment

FinancialReport: EntityType
     properties:
        desc: Text
            index: Text
        semanticType: Text
            index: Text
        reportType: Text
            index: Text
        filingDate: Text
            index: Text
        category: ReportType
     relations:
        issuedBy: Company
        covers: TimePeriod

MarketData: EntityType
     properties:
        desc: Text
            index: Text
        semanticType: Text
            index: Text
        value: Text
            index: Text
     relations:
        relatedTo: Company
        recordedAt: TimePeriod

FinancialEvent: EntityType
     properties:
        desc: Text
            index: Text
        semanticType: Text
            index: Text
        eventDate: Text
            index: Text
        eventType: Text
            index: Text
        category: EventType
     relations:
        involves: Company
        occurredIn: TimePeriod

BusinessSegment: EntityType
     properties:
        desc: Text
            index: Text
        semanticType: Text
            index: Text
     relations:
        hasRevenue: Revenue
        hasProfit: Profit
        partOf: Company

GeographicRegion: EntityType
     properties:
        desc: Text
            index: Text
        semanticType: Text
            index: Text
        regionType: RegionType
     relations:
        contains: Company

RegulatoryFiling: EntityType
     properties:
        desc: Text
            index: Text
        semanticType: Text
            index: Text
        filingType: Text
            index: Text
     relations:
        filedBy: Company
        covers: TimePeriod

FinancialStatement: EntityType
     properties:
        desc: Text
            index: Text
        semanticType: Text
            index: Text
        statementType: Text
            index: Text
     relations:
        reportedBy: Company
        reportedIn: TimePeriod
        hasRevenue: Revenue
        hasProfit: Profit
        hasExpense: Expense
        hasAsset: Asset
        hasLiability: Liability
        includes: FinancialMetric

Others: EntityType
     properties:
        desc: Text
            index: TextAndVector
        semanticType: Text
            index: Text