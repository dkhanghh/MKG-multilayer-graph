# Neo4j Configuration
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your_password_here
NEO4J_DATABASE=neo4j

# OpenAI Configuration (for chat)
OPENAI_API_KEY=your_openai_key_here
# OPENAI_BASE_URL=https://api.openai.com/v1  # Optional: Custom OpenAI-compatible API endpoint
# LLM_MODEL=gpt-4o-mini  # Model name to use (default: gpt-4o-mini)
# LLM_TEMPERATURE=0.1  # Temperature for LLM generation (default: 0.1)

# For custom endpoints that don't require authentication (e.g., vLLM, LM Studio, Ollama):
# 1. Set OPENAI_BASE_URL to your endpoint
# 2. Leave OPENAI_API_KEY unset or empty (code will automatically use "EMPTY")
# 3. Set LLM_MODEL to your endpoint's model name
# Example:
# OPENAI_BASE_URL=https://llm.duykhangh.net/v1
# LLM_MODEL=gpt-oss-20b
# (OPENAI_API_KEY remains unset)

# Embedding Configuration
# Choose embedding provider: gemini, ollama, or sentence-transformers
EMBEDDING_PROVIDER=gemini

# Gemini Embeddings (when EMBEDDING_PROVIDER=gemini)
# Note: Gemini embedding dimension is 768
GOOGLE_API_KEY=your_google_api_key_here
EMBEDDING_MODEL=gemini-embedding-001

# Ollama Embeddings (when EMBEDDING_PROVIDER=ollama)
# OLLAMA_BASE_URL=http://localhost:11434
# EMBEDDING_MODEL=nomic-embed-text

# Sentence Transformers (when EMBEDDING_PROVIDER=sentence-transformers)
# EMBEDDING_MODEL=sentence-transformers/all-mpnet-base-v2
