# Server Configuration
# Copy this file to .env and update with your values

# Pipeline Configuration
# Path to YAML configuration file for the pipeline
# If not set, uses the default configuration from server/core/config.py
CONFIG_FILE=

# API Keys
OPENAI_API_KEY=your-openai-api-key-here

# Database Configuration (for Neo4j writer)
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=
NEO4J_PASSWORD=
NEO4J_DATABASE=

# Server Settings
HOST=0.0.0.0
PORT=8000
DEBUG=false

# Tracing (optional)
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=
